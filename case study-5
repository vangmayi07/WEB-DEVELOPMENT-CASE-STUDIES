<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Student Dashboard | Malla Reddy University</title>

  <!-- Bootstrap 5 CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <style>
    :root {
      --mru-navy: #123653;
      --mru-blue: #1769aa;
      --mru-orange: #f58232;
    }

    body {
      background: #f4f7fa;
    }

    .navbar-mru {
      background: var(--mru-navy);
    }

    .brand-mark {
      display: inline-grid;
      width: 40px;
      height: 40px;
      place-items: center;
      margin-right: .5rem;
      border: 1px solid rgba(255,255,255,.5);
      border-radius: 10px;
      color: #ffd8bd;
      font-size: .85rem;
      font-weight: 800;
    }

    .dashboard-header {
      color: #fff;
      background: linear-gradient(115deg, var(--mru-navy), var(--mru-blue));
    }

    .card-stat {
      border: 0;
      box-shadow: 0 .35rem 1.2rem rgba(18, 54, 83, .08);
    }

    .stat-value {
      color: var(--mru-blue);
      font-size: 2rem;
      font-weight: 750;
    }

    .carousel-item {
      min-height: 210px;
      padding: 2.5rem;
      color: #fff;
      background: linear-gradient(120deg, #1769aa, #123653);
    }

    .carousel-item:nth-child(2) {
      background: linear-gradient(120deg, #a34c12, #f58232);
    }

    .carousel-item:nth-child(3) {
      background: linear-gradient(120deg, #18794e, #125e62);
    }

    .section-title {
      color: var(--mru-navy);
    }

    footer {
      color: #667085;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark navbar-mru">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="#">
        <span class="brand-mark">MRU</span>
        <span>Malla Reddy University</span>
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
        data-bs-target="#mainNavigation" aria-controls="mainNavigation"
        aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNavigation">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link active" href="#dashboard">Dashboard</a></li>
          <li class="nav-item"><a class="nav-link" href="#academics">Academics</a></li>
          <li class="nav-item"><a class="nav-link" href="#announcements">Announcements</a></li>
        </ul>
        <button class="btn btn-outline-light btn-sm ms-lg-3" data-bs-toggle="modal"
          data-bs-target="#profileModal">My profile</button>
      </div>
    </div>
  </nav>

  <main>
    <!-- Welcome banner -->
    <section id="dashboard" class="dashboard-header py-5">
      <div class="container">
        <div class="row align-items-center g-3">
          <div class="col-md-8">
            <p class="text-white-50 mb-1">STUDENT DASHBOARD</p>
            <h1 class="h2 mb-2">Welcome, Alex Johnson</h1>
            <p class="mb-0">Student ID: MRU2026001 · B.Tech Computer Science</p>
          </div>
          <div class="col-md-4 text-md-end">
            <button class="btn btn-light" data-bs-toggle="modal"
              data-bs-target="#helpModal">Get help</button>
          </div>
        </div>
      </div>
    </section>

    <div class="container py-4">
      <!-- Alert -->
      <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Reminder:</strong> Review the examination timetable and complete your registration before the deadline.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>

      <!-- Summary cards: Bootstrap grid + cards -->
      <section class="row g-3 mb-4" aria-label="Student summary">
        <div class="col-12 col-sm-6 col-lg-3">
          <article class="card card-stat h-100">
            <div class="card-body">
              <h2 class="h6 text-secondary">Attendance</h2>
              <p class="stat-value mb-1">86%</p>
              <p class="small text-secondary mb-0">Overall this semester</p>
            </div>
          </article>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
          <article class="card card-stat h-100">
            <div class="card-body">
              <h2 class="h6 text-secondary">Current GPA</h2>
              <p class="stat-value mb-1">8.4</p>
              <p class="small text-secondary mb-0">Through previous semester</p>
            </div>
          </article>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
          <article class="card card-stat h-100">
            <div class="card-body">
              <h2 class="h6 text-secondary">Assignments</h2>
              <p class="stat-value mb-1">3</p>
              <p class="small text-secondary mb-0">Pending submission</p>
            </div>
          </article>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
          <article class="card card-stat h-100">
            <div class="card-body">
              <h2 class="h6 text-secondary">Next exam</h2>
              <p class="stat-value mb-1">10 Dec</p>
              <p class="small text-secondary mb-0">Data Structures</p>
            </div>
          </article>
        </div>
      </section>

      <div class="row g-4">
        <!-- Timetable table -->
        <section id="academics" class="col-lg-7">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 section-title mb-0">Today's timetable</h2>
                <a class="btn btn-sm btn-outline-primary" href="#full-timetable">Full timetable</a>
              </div>
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th scope="col">Time</th>
                      <th scope="col">Course</th>
                      <th scope="col">Room</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>09:00 AM</td>
                      <td>Data Structures</td>
                      <td>Block A · 204</td>
                      <td><span class="badge text-bg-success">Completed</span></td>
                    </tr>
                    <tr>
                      <td>11:00 AM</td>
                      <td>Database Systems</td>
                      <td>Block B · 106</td>
                      <td><span class="badge text-bg-primary">Upcoming</span></td>
                    </tr>
                    <tr>
                      <td>02:00 PM</td>
                      <td>Web Technologies Lab</td>
                      <td>Lab 3</td>
                      <td><span class="badge text-bg-secondary">Scheduled</span></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <!-- Announcements carousel -->
        <section id="announcements" class="col-lg-5">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
              <h2 class="h5 section-title mb-3">Campus announcements</h2>
              <div id="announcementCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                  <button type="button" data-bs-target="#announcementCarousel" data-bs-slide-to="0"
                    class="active" aria-current="true" aria-label="Announcement 1"></button>
                  <button type="button" data-bs-target="#announcementCarousel" data-bs-slide-to="1"
                    aria-label="Announcement 2"></button>
                  <button type="button" data-bs-target="#announcementCarousel" data-bs-slide-to="2"
                    aria-label="Announcement 3"></button>
                </div>
                <div class="carousel-inner rounded">
                  <div class="carousel-item active">
                    <p class="small text-uppercase mb-2">Examinations</p>
                    <h3 class="h4">End-term timetable released</h3>
                    <p class="mb-0">Check the student portal for your examination schedule.</p>
                  </div>
                  <div class="carousel-item">
                    <p class="small text-uppercase mb-2">Library</p>
                    <h3 class="h4">Extended study hours</h3>
                    <p class="mb-0">The central library will stay open later during exam week.</p>
                  </div>
                  <div class="carousel-item">
                    <p class="small text-uppercase mb-2">Campus</p>
                    <h3 class="h4">Student services update</h3>
                    <p class="mb-0">Review the latest circular for service desk timings.</p>
                  </div>
                </div>
                <button class="carousel-control-prev" type="button"
                  data-bs-target="#announcementCarousel" data-bs-slide="prev"
                  aria-label="Previous announcement">
                  <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button"
                  data-bs-target="#announcementCarousel" data-bs-slide="next"
                  aria-label="Next announcement">
                  <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
              </div>
            </div>
          </div>
        </section>

        <!-- Quick links -->
        <section class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-body">
              <h2 class="h5 section-title">Quick links</h2>
              <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="#library">Library</a>
                <a class="btn btn-outline-primary" href="#transport">Transport</a>
                <a class="btn btn-outline-primary" href="#hostel">Hostel services</a>
                <a class="btn btn-outline-primary" href="#helpdesk">Student helpdesk</a>
                <button class="btn btn-outline-secondary" data-bs-toggle="modal"
                  data-bs-target="#feedbackModal">Send feedback</button>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- AI usage documentation -->
      <section class="mt-4" aria-labelledby="ai-notes-title">
        <div class="accordion" id="aiNotes">
          <div class="accordion-item">
            <h2 class="accordion-header" id="aiNotesHeading">
              <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse" data-bs-target="#aiNotesContent"
                aria-expanded="false" aria-controls="aiNotesContent">
                Generative AI usage notes
              </button>
            </h2>
            <div id="aiNotesContent" class="accordion-collapse collapse"
              aria-labelledby="aiNotesHeading" data-bs-parent="#aiNotes">
              <div class="accordion-body">
                <h3 id="ai-notes-title" class="h6">How AI assisted with this Bootstrap page</h3>
                <ul class="mb-0">
                  <li><strong>Generate:</strong> AI was prompted to draft a Bootstrap 5 dashboard structure.</li>
                  <li><strong>Customise:</strong> The generated layout was adapted with university dashboard labels and sample student information.</li>
                  <li><strong>Improve:</strong> Responsive grid classes, accessible labels, and Bootstrap components were reviewed and refined.</li>
                  <li><strong>Debug:</strong> Component IDs, modal targets, and responsive table behaviour were checked.</li>
                </ul>
                <p class="small text-secondary mt-2 mb-0">
                  Edit these notes to accurately describe your own use of Generative AI.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <footer class="text-center py-4">
        <small>Malla Reddy University · Student Dashboard demo · Replace sample details with official information.</small>
      </footer>
    </div>
  </main>

  <!-- Profile modal -->
  <div class="modal fade" id="profileModal" tabindex="-1" aria-labelledby="profileModalTitle" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="profileModalTitle">Student profile</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p><strong>Name:</strong> Alex Johnson</p>
          <p><strong>Student ID:</strong> MRU2026001</p>
          <p class="mb-0"><strong>Programme:</strong> B.Tech Computer Science</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Help modal -->
  <div class="modal fade" id="helpModal" tabindex="-1" aria-labelledby="helpModalTitle" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="helpModalTitle">Student helpdesk</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          For assistance, contact your department office or email
          <a href="mailto:helpdesk@mru.edu.in">helpdesk@mru.edu.in</a>.
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Got it</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Feedback modal -->
  <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalTitle" aria-hidden="true">
    <div class="modal-dialog">
      <form class="modal-content" onsubmit="event.preventDefault(); alert('Thank you for your feedback!');">
        <div class="modal-header">
          <h2 class="modal-title fs-5" id="feedbackModalTitle">Send feedback</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <label for="feedbackText" class="form-label">Your feedback</label>
          <textarea id="feedbackText" class="form-control" rows="4" required></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Submit</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Bootstrap 5 JavaScript bundle for navbar, carousel, alerts, accordion, and modals -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
