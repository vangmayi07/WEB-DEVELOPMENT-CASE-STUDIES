Here’s the HTML for the **Student Services Homepage**, with all visual styling delegated to an external `styles.css` file. Save the HTML and CSS in the same folder.

**`index.html`**

```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Quick access to Malla Reddy University student services.">
  <title>Student Services | Malla Reddy University</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="#home" aria-label="Malla Reddy University home">
      <span class="brand-mark" aria-hidden="true">MRU</span>
      <span>
        <strong>Malla Reddy University</strong>
        <small>Student Services</small>
      </span>
    </a>

    <nav aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="#services">Services</a></li>
        <li><a href="#examinations">Examinations</a></li>
        <li><a href="#announcements">Announcements</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main id="home">
    <section class="hero" aria-labelledby="welcome-title">
      <div class="hero-content">
        <p class="eyebrow">Your campus, connected</p>
        <h1 id="welcome-title">Welcome to Student Services</h1>
        <p>
          Find the university services, academic information, and campus support
          you need in one place.
        </p>
        <a class="button button-primary" href="#services">Explore services</a>
      </div>
    </section>

    <section id="services" class="section" aria-labelledby="services-title">
      <div class="section-heading">
        <p class="eyebrow">Quick access</p>
        <h2 id="services-title">Student Services</h2>
        <p>Select a service to find information and support.</p>
      </div>

      <div class="service-grid">
        <article class="service-card">
          <span class="service-icon" aria-hidden="true">📚</span>
          <h3>Library</h3>
          <p>Explore learning resources, library timings, and borrowing support.</p>
          <a href="#" class="card-link">Visit library <span aria-hidden="true">→</span></a>
        </article>

        <article class="service-card">
          <span class="service-icon" aria-hidden="true">🚌</span>
          <h3>Transport</h3>
          <p>Find bus routes, transport office details, and pass information.</p>
          <a href="#" class="card-link">Transport details <span aria-hidden="true">→</span></a>
        </article>

        <article class="service-card">
          <span class="service-icon" aria-hidden="true">🏠</span>
          <h3>Hostel</h3>
          <p>Access hostel information, student guidance, and contact details.</p>
          <a href="#" class="card-link">Hostel services <span aria-hidden="true">→</span></a>
        </article>

        <article class="service-card">
          <span class="service-icon" aria-hidden="true">💼</span>
          <h3>Placements</h3>
          <p>Discover career resources, placement announcements, and support.</p>
          <a href="#" class="card-link">Placement cell <span aria-hidden="true">→</span></a>
        </article>

        <article id="examinations" class="service-card">
          <span class="service-icon" aria-hidden="true">📝</span>
          <h3>Examinations</h3>
          <p>Check examination notifications, timetables, and student guidelines.</p>
          <a href="#" class="card-link">Exam information <span aria-hidden="true">→</span></a>
        </article>

        <article class="service-card">
          <span class="service-icon" aria-hidden="true">🧑‍🎓</span>
          <h3>Student Helpdesk</h3>
          <p>Get help with academic questions and university services.</p>
          <a href="#" class="card-link">Contact helpdesk <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>

    <section id="announcements" class="announcement section" aria-labelledby="announcement-title">
      <div>
        <p class="eyebrow">Stay informed</p>
        <h2 id="announcement-title">Latest Announcements</h2>
        <p>Check the university notice board for current circulars and updates.</p>
      </div>
      <a class="button button-secondary" href="#">View all announcements</a>
    </section>
  </main>

  <footer id="contact" class="site-footer">
    <p><strong>Malla Reddy University</strong> · Student Services</p>
    <p>Email: <a href="mailto:helpdesk@mru.edu.in">helpdesk@mru.edu.in</a></p>
    <p>&copy; 2026 Malla Reddy University</p>
  </footer>
</body>
</html>
```

**`styles.css`**

```css
:root {
  --navy: #123653;
  --blue: #1769aa;
  --orange: #f58232;
  --ink: #1d2938;
  --muted: #637387;
  --surface: #ffffff;
  --background: #f4f7fa;
  --border: #e1e8ef;
  --shadow: 0 8px 24px rgb(18 54 83 / 8%);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--ink);
  background: var(--background);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding: 1rem max(5vw, 1.25rem);
  color: white;
  background: var(--navy);
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
}

.brand strong,
.brand small {
  display: block;
}

.brand small {
  color: #c8d9e8;
}

.brand-mark {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  border: 1px solid rgb(255 255 255 / 40%);
  border-radius: 12px;
  color: #ffd8bd;
  font-weight: 800;
}

.nav-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.nav-list a {
  display: block;
  padding: 0.55rem 0.75rem;
  border-radius: 7px;
  color: #e8f0f6;
  text-decoration: none;
  transition: background-color 180ms ease, color 180ms ease;
}

.nav-list a:hover,
.nav-list a:focus-visible {
  color: white;
  background: rgb(255 255 255 / 15%);
}

.hero {
  display: flex;
  min-height: 330px;
  align-items: center;
  padding: 4rem max(8vw, 1.5rem);
  color: white;
  background: linear-gradient(115deg, #123653, #1769aa);
  animation: appear 650ms ease-out both;
}

.hero-content {
  max-width: 720px;
}

.hero h1 {
  max-width: 650px;
  margin: 0.25rem 0 0.75rem;
  font-size: clamp(2.2rem, 5vw, 3.6rem);
  line-height: 1.1;
}

.hero p {
  max-width: 600px;
  color: #e0edf7;
}

.eyebrow {
  margin: 0;
  color: var(--orange);
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.button {
  display: inline-block;
  padding: 0.75rem 1rem;
  border: 2px solid transparent;
  border-radius: 8px;
  font-weight: 700;
  text-decoration: none;
  transition: transform 180ms ease, background-color 180ms ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  margin-top: 0.75rem;
  color: var(--navy);
  background: white;
}

.button-primary:hover {
  background: #eaf4fb;
}

.button-secondary {
  color: white;
  background: var(--blue);
}

.button-secondary:hover {
  background: var(--navy);
}

.section {
  max-width: 1180px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
}

.section-heading {
  margin-bottom: 1.5rem;
}

.section-heading h2,
.announcement h2 {
  margin: 0.2rem 0;
  color: var(--navy);
  font-size: 2rem;
}

.section-heading > p:last-child,
.announcement p:last-child {
  color: var(--muted);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.service-card {
  padding: 1.4rem;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: var(--surface);
  box-shadow: var(--shadow);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.service-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 30px rgb(18 54 83 / 14%);
}

.service-icon {
  font-size: 1.8rem;
}

.service-card h3 {
  margin: 0.6rem 0 0.25rem;
  color: var(--navy);
}

.service-card p {
  min-height: 3.2em;
  color: var(--muted);
}

.card-link {
  color: var(--blue);
  font-weight: 700;
  text-decoration: none;
}

.card-link:hover {
  text-decoration: underline;
}

.announcement {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 2rem;
  border-radius: 14px;
  background: white;
  box-shadow: var(--shadow);
}

.site-footer {
  padding: 1.5rem;
  color: #e8f0f6;
  background: var(--navy);
  text-align: center;
}

.site-footer p {
  margin: 0.35rem;
}

.site-footer a {
  color: white;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 760px) {
  .site-header {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .announcement {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 520px) {
  .service-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    min-height: 280px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
```
